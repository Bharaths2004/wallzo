# ================================================================
# .env.docker — Docker Production Environment Variables
# Copy this to .env in the project root before running:
#   docker compose up -d --build
# ================================================================

# PostgreSQL credentials (used by both postgres container and backend)
POSTGRES_USER=wallzo_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=wallzodb

# JWT — generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Your domain or server IP
# Local:       http://localhost
# Production:  https://wallzo.in
CLIENT_URL=http://localhost

# API URL seen by the browser (used during React build)
# Local:       /api   (relative — Nginx handles the proxy)
# Production:  /api   (same — keep relative)
VITE_API_URL=/api
