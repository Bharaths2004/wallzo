generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // user, admin, super_admin
  avatar    String?  @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  wishlist  Product[] @relation("UserWishlist")
  orders    Order[]
  actions   PendingAction[] @relation("ActionSubmitter")
  reviewedActions PendingAction[] @relation("ActionReviewer")
  createdProducts Product[] @relation("ProductCreator")
  approvedProducts Product[] @relation("ProductApprover")
}

model Address {
  id      String @id @default(cuid())
  label   String @default("Home")
  name    String?
  line1   String
  line2   String?
  city    String
  state   String
  pincode String
  phone   String

  userId  String
  user    User   @relation(fields: [userId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String   @default("posters")
  subCategory String
  description String
  images      String[]
  basePrice   Float
  tags        String[]
  status      String   @default("active") // active, draft, archived
  approvalStatus String @default("approved") // pending, approved, rejected
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  isNew       Boolean  @default(false)
  isTrending  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    Variant[]
  wishedBy    User[]   @relation("UserWishlist")
  orderItems  OrderItem[]

  createdById String?
  createdBy   User?    @relation("ProductCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy  User?    @relation("ProductApprover", fields: [approvedById], references: [id])
}

model Variant {
  id        String  @id @default(cuid())
  size      String
  sku       String
  stock     Int     @default(0)
  price     Float

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String   @id @default(cuid())
  orderId       String   @unique // WZ-10001
  status        String   @default("pending") // pending, processing, shipped, delivered, cancelled
  paymentStatus String   @default("pending") // pending, paid, failed, refunded
  paymentId     String?
  paymentMethod String   @default("upi")
  
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingPincode String?
  shippingPhone   String?

  subtotal      Float
  shippingCharge Float  @default(0)
  discount      Float  @default(0)
  total         Float
  trackingNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  items         OrderItem[]
  timeline      OrderTimeline[]
}

model OrderItem {
  id        String  @id @default(cuid())
  name      String
  image     String?
  size      String?
  sku       String?
  qty       Int
  price     Float

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model OrderTimeline {
  id      String   @id @default(cuid())
  status  String?
  note    String?
  date    DateTime @default(now())

  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PendingAction {
  id          String   @id @default(cuid())
  type        String   // ADD_PRODUCT, UPDATE_PRODUCT, DELETE_PRODUCT, UPDATE_STOCK
  payload     Json     
  status      String   @default("pending") // pending, approved, rejected
  reviewNote  String?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?

  submittedById String
  submittedBy   User   @relation("ActionSubmitter", fields: [submittedById], references: [id])
  
  reviewedById  String?
  reviewedBy    User?  @relation("ActionReviewer", fields: [reviewedById], references: [id])
}
